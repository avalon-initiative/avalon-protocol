{
  "description": "Canonical encoding of free-form payloads: RFC 8785 with two restrictions. A number is valid only when its decimal text survives a round trip through an IEEE double unchanged (integers within +/-2^53 written without fraction or exponent, other numbers with at most 15 significant digits written exactly as ECMAScript prints them); anything else must be a string. Duplicate object keys are rejected. Object keys sort by UTF-16 code units. input.jsonUtf8 is the document text; expected is either canonicalUtf8 (the exact canonical text) or error, one of invalid_number, duplicate_key, malformed. The first problem in document order decides the error. Generated by scripts/gen-canonical-payload-vectors.py, an implementation independent of the Rust one.",
  "supportedIn": [],
  "notSupported": {
    "rust": "the SDK has no canonical payload encoder yet",
    "csharp": "the SDK has no canonical payload encoder yet",
    "typescript": "the SDK has no canonical payload encoder yet"
  },
  "vectors": [
    {
      "name": "keys sort ascending",
      "input": {
        "jsonUtf8": "{\"b\":1,\"a\":2,\"c\":3}"
      },
      "expected": {
        "canonicalUtf8": "{\"a\":2,\"b\":1,\"c\":3}"
      }
    },
    {
      "name": "keys sort by code unit, uppercase before lowercase",
      "input": {
        "jsonUtf8": "{\"a\":1,\"B\":2,\"A\":3,\"b\":4}"
      },
      "expected": {
        "canonicalUtf8": "{\"A\":3,\"B\":2,\"a\":1,\"b\":4}"
      }
    },
    {
      "name": "empty key sorts first",
      "input": {
        "jsonUtf8": "{\"a\":1,\"\":2}"
      },
      "expected": {
        "canonicalUtf8": "{\"\":2,\"a\":1}"
      }
    },
    {
      "name": "non-BMP key sorts before U+E000 (UTF-16 order, not code point order)",
      "input": {
        "jsonUtf8": "{\"\ue000\":1,\"\ud800\udc00\":2}"
      },
      "expected": {
        "canonicalUtf8": "{\"\ud800\udc00\":2,\"\ue000\":1}"
      }
    },
    {
      "name": "non-BMP key sorts before U+FFFF",
      "input": {
        "jsonUtf8": "{\"\uffff\":1,\"\ud83d\ude00\":2}"
      },
      "expected": {
        "canonicalUtf8": "{\"\ud83d\ude00\":2,\"\uffff\":1}"
      }
    },
    {
      "name": "non-BMP keys order by surrogates",
      "input": {
        "jsonUtf8": "{\"\ud83d\ude01\":1,\"\ud83d\ude00\":2,\"\ud800\udc00\":3}"
      },
      "expected": {
        "canonicalUtf8": "{\"\ud800\udc00\":3,\"\ud83d\ude00\":2,\"\ud83d\ude01\":1}"
      }
    },
    {
      "name": "BMP above surrogates sorts after non-BMP",
      "input": {
        "jsonUtf8": "{\"\ud7ff\":1,\"\ue000\":2,\"\ud800\udc00\":3,\"\uff5e\":4}"
      },
      "expected": {
        "canonicalUtf8": "{\"\ud7ff\":1,\"\ud800\udc00\":3,\"\ue000\":2,\"\uff5e\":4}"
      }
    },
    {
      "name": "keys given as escapes are decoded before sorting",
      "input": {
        "jsonUtf8": "{\"\\ud83d\\ude00\":1,\"\\uffff\":2,\"a\":3}"
      },
      "expected": {
        "canonicalUtf8": "{\"a\":3,\"\ud83d\ude00\":1,\"\uffff\":2}"
      }
    },
    {
      "name": "key prefix sorts first",
      "input": {
        "jsonUtf8": "{\"ab\":1,\"a\":2,\"abc\":3}"
      },
      "expected": {
        "canonicalUtf8": "{\"a\":2,\"ab\":1,\"abc\":3}"
      }
    },
    {
      "name": "nested objects sort independently",
      "input": {
        "jsonUtf8": "{\"z\":{\"y\":1,\"x\":2},\"a\":{\"d\":[{\"b\":1,\"a\":2}],\"c\":3}}"
      },
      "expected": {
        "canonicalUtf8": "{\"a\":{\"c\":3,\"d\":[{\"a\":2,\"b\":1}]},\"z\":{\"x\":2,\"y\":1}}"
      }
    },
    {
      "name": "array order is preserved",
      "input": {
        "jsonUtf8": "[3,1,2,{\"b\":1,\"a\":2}]"
      },
      "expected": {
        "canonicalUtf8": "[3,1,2,{\"a\":2,\"b\":1}]"
      }
    },
    {
      "name": "short escapes",
      "input": {
        "jsonUtf8": "[\"\\b\\t\\n\\f\\r\\\"\\\\\"]"
      },
      "expected": {
        "canonicalUtf8": "[\"\\b\\t\\n\\f\\r\\\"\\\\\"]"
      }
    },
    {
      "name": "other control characters use lowercase hex",
      "input": {
        "jsonUtf8": "[\"\\u0000\\u0001\\u001f\\u001F\"]"
      },
      "expected": {
        "canonicalUtf8": "[\"\\u0000\\u0001\\u001f\\u001f\"]"
      }
    },
    {
      "name": "slash escape is decoded and not re-escaped",
      "input": {
        "jsonUtf8": "[\"a\\/b\"]"
      },
      "expected": {
        "canonicalUtf8": "[\"a/b\"]"
      }
    },
    {
      "name": "DEL and U+2028 are literal",
      "input": {
        "jsonUtf8": "[\"\\u007f\\u2028\\u2029\"]"
      },
      "expected": {
        "canonicalUtf8": "[\"\u007f\u2028\u2029\"]"
      }
    },
    {
      "name": "unicode escapes are decoded to the character",
      "input": {
        "jsonUtf8": "[\"\\u0041\\u00e9\\u20ac\"]"
      },
      "expected": {
        "canonicalUtf8": "[\"A\u00e9\u20ac\"]"
      }
    },
    {
      "name": "surrogate pair escape becomes one non-BMP character",
      "input": {
        "jsonUtf8": "[\"\\ud83d\\ude00\"]"
      },
      "expected": {
        "canonicalUtf8": "[\"\ud83d\ude00\"]"
      }
    },
    {
      "name": "literal non-BMP character is kept",
      "input": {
        "jsonUtf8": "[\"\ud83d\ude00\"]"
      },
      "expected": {
        "canonicalUtf8": "[\"\ud83d\ude00\"]"
      }
    },
    {
      "name": "composed and decomposed forms stay distinct",
      "input": {
        "jsonUtf8": "[\"\u00e9\",\"e\u0301\"]"
      },
      "expected": {
        "canonicalUtf8": "[\"\u00e9\",\"e\u0301\"]"
      }
    },
    {
      "name": "empty string",
      "input": {
        "jsonUtf8": "[\"\"]"
      },
      "expected": {
        "canonicalUtf8": "[\"\"]"
      }
    },
    {
      "name": "key with escapes is re-escaped canonically",
      "input": {
        "jsonUtf8": "{\"a\\u0001\\\"b\":1}"
      },
      "expected": {
        "canonicalUtf8": "{\"a\\u0001\\\"b\":1}"
      }
    },
    {
      "name": "zero",
      "input": {
        "jsonUtf8": "[0]"
      },
      "expected": {
        "canonicalUtf8": "[0]"
      }
    },
    {
      "name": "small integers",
      "input": {
        "jsonUtf8": "[1,-1,10,100]"
      },
      "expected": {
        "canonicalUtf8": "[1,-1,10,100]"
      }
    },
    {
      "name": "integer at the upper bound",
      "input": {
        "jsonUtf8": "[9007199254740992]"
      },
      "expected": {
        "canonicalUtf8": "[9007199254740992]"
      }
    },
    {
      "name": "integer at the lower bound",
      "input": {
        "jsonUtf8": "[-9007199254740992]"
      },
      "expected": {
        "canonicalUtf8": "[-9007199254740992]"
      }
    },
    {
      "name": "integer just below the bounds",
      "input": {
        "jsonUtf8": "[9007199254740991,-9007199254740991]"
      },
      "expected": {
        "canonicalUtf8": "[9007199254740991,-9007199254740991]"
      }
    },
    {
      "name": "integer just above the upper bound",
      "input": {
        "jsonUtf8": "[9007199254740993]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "integer just above the upper bound, exactly representable",
      "input": {
        "jsonUtf8": "[9007199254740994]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "integer just below the lower bound",
      "input": {
        "jsonUtf8": "[-9007199254740993]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "integer far beyond 64 bits",
      "input": {
        "jsonUtf8": "[123456789012345678901234567890]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "decimal fraction",
      "input": {
        "jsonUtf8": "[0.5,-0.5,0.1,4.35]"
      },
      "expected": {
        "canonicalUtf8": "[0.5,-0.5,0.1,4.35]"
      }
    },
    {
      "name": "fraction with 15 significant digits",
      "input": {
        "jsonUtf8": "[0.123456789012345]"
      },
      "expected": {
        "canonicalUtf8": "[0.123456789012345]"
      }
    },
    {
      "name": "fraction with 16 significant digits",
      "input": {
        "jsonUtf8": "[0.1234567890123456]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "fraction with 15 digits and a large integer part",
      "input": {
        "jsonUtf8": "[12345678901234.5]"
      },
      "expected": {
        "canonicalUtf8": "[12345678901234.5]"
      }
    },
    {
      "name": "fraction with 16 digits and a large integer part",
      "input": {
        "jsonUtf8": "[123456789012345.6]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "smallest decimal before exponent form",
      "input": {
        "jsonUtf8": "[0.000001]"
      },
      "expected": {
        "canonicalUtf8": "[0.000001]"
      }
    },
    {
      "name": "exponent form below 1e-6",
      "input": {
        "jsonUtf8": "[1e-7,1.5e-7,-2.5e-10]"
      },
      "expected": {
        "canonicalUtf8": "[1e-7,1.5e-7,-2.5e-10]"
      }
    },
    {
      "name": "denormal minimum",
      "input": {
        "jsonUtf8": "[5e-324]"
      },
      "expected": {
        "canonicalUtf8": "[5e-324]"
      }
    },
    {
      "name": "trailing zero in fraction changes the text",
      "input": {
        "jsonUtf8": "[1.0]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "trailing zero after digits changes the text",
      "input": {
        "jsonUtf8": "[0.10]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "exponent on an integer changes the text",
      "input": {
        "jsonUtf8": "[1e2]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "plus sign in exponent changes the text",
      "input": {
        "jsonUtf8": "[1e+2]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "uppercase exponent changes the text",
      "input": {
        "jsonUtf8": "[1E-7]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "negative zero",
      "input": {
        "jsonUtf8": "[-0]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "negative zero with fraction",
      "input": {
        "jsonUtf8": "[-0.0]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "positive zero with fraction",
      "input": {
        "jsonUtf8": "[0.0]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "integer-valued exponent form beyond 2^53",
      "input": {
        "jsonUtf8": "[1e21]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "integer-valued 1e16",
      "input": {
        "jsonUtf8": "[1e16]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "largest double",
      "input": {
        "jsonUtf8": "[1.7976931348623157e308]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "overflowing exponent",
      "input": {
        "jsonUtf8": "[1e400]"
      },
      "expected": {
        "error": "invalid_number"
      }
    },
    {
      "name": "leading zero",
      "input": {
        "jsonUtf8": "[01]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "plus sign",
      "input": {
        "jsonUtf8": "[+1]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "bare fraction",
      "input": {
        "jsonUtf8": "[.5]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "trailing dot",
      "input": {
        "jsonUtf8": "[1.]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "NaN literal",
      "input": {
        "jsonUtf8": "[NaN]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "Infinity literal",
      "input": {
        "jsonUtf8": "[Infinity]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "duplicate top-level key",
      "input": {
        "jsonUtf8": "{\"a\":1,\"a\":2}"
      },
      "expected": {
        "error": "duplicate_key"
      }
    },
    {
      "name": "duplicate with identical value",
      "input": {
        "jsonUtf8": "{\"a\":1,\"a\":1}"
      },
      "expected": {
        "error": "duplicate_key"
      }
    },
    {
      "name": "duplicate in nested object",
      "input": {
        "jsonUtf8": "{\"x\":{\"b\":1,\"b\":2}}"
      },
      "expected": {
        "error": "duplicate_key"
      }
    },
    {
      "name": "duplicate inside array element",
      "input": {
        "jsonUtf8": "[{\"k\":1,\"k\":2}]"
      },
      "expected": {
        "error": "duplicate_key"
      }
    },
    {
      "name": "duplicate after key decoding",
      "input": {
        "jsonUtf8": "{\"a\":1,\"\\u0061\":2}"
      },
      "expected": {
        "error": "duplicate_key"
      }
    },
    {
      "name": "duplicate non-BMP key",
      "input": {
        "jsonUtf8": "{\"\ud83d\ude00\":1,\"\\ud83d\\ude00\":2}"
      },
      "expected": {
        "error": "duplicate_key"
      }
    },
    {
      "name": "keys differing in case are distinct",
      "input": {
        "jsonUtf8": "{\"a\":1,\"A\":2}"
      },
      "expected": {
        "canonicalUtf8": "{\"A\":2,\"a\":1}"
      }
    },
    {
      "name": "same key in different objects is fine",
      "input": {
        "jsonUtf8": "{\"a\":{\"k\":1},\"b\":{\"k\":2}}"
      },
      "expected": {
        "canonicalUtf8": "{\"a\":{\"k\":1},\"b\":{\"k\":2}}"
      }
    },
    {
      "name": "empty object",
      "input": {
        "jsonUtf8": "{}"
      },
      "expected": {
        "canonicalUtf8": "{}"
      }
    },
    {
      "name": "empty array",
      "input": {
        "jsonUtf8": "[]"
      },
      "expected": {
        "canonicalUtf8": "[]"
      }
    },
    {
      "name": "empty containers nested",
      "input": {
        "jsonUtf8": "{\"b\":[],\"a\":{},\"c\":[[],{}]}"
      },
      "expected": {
        "canonicalUtf8": "{\"a\":{},\"b\":[],\"c\":[[],{}]}"
      }
    },
    {
      "name": "null true false",
      "input": {
        "jsonUtf8": "{\"n\":null,\"t\":true,\"f\":false}"
      },
      "expected": {
        "canonicalUtf8": "{\"f\":false,\"n\":null,\"t\":true}"
      }
    },
    {
      "name": "top-level string",
      "input": {
        "jsonUtf8": "\"x\""
      },
      "expected": {
        "canonicalUtf8": "\"x\""
      }
    },
    {
      "name": "top-level number",
      "input": {
        "jsonUtf8": "42"
      },
      "expected": {
        "canonicalUtf8": "42"
      }
    },
    {
      "name": "top-level null",
      "input": {
        "jsonUtf8": "null"
      },
      "expected": {
        "canonicalUtf8": "null"
      }
    },
    {
      "name": "insignificant whitespace is dropped",
      "input": {
        "jsonUtf8": " \n{ \"b\" : [ 1 , 2 ] ,\t\"a\" : { } }\r\n"
      },
      "expected": {
        "canonicalUtf8": "{\"a\":{},\"b\":[1,2]}"
      }
    },
    {
      "name": "deep nesting",
      "input": {
        "jsonUtf8": "{\"a\":{\"b\":{\"c\":{\"d\":[[[[1]]]]}}}}"
      },
      "expected": {
        "canonicalUtf8": "{\"a\":{\"b\":{\"c\":{\"d\":[[[[1]]]]}}}}"
      }
    },
    {
      "name": "empty input",
      "input": {
        "jsonUtf8": ""
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "trailing comma in object",
      "input": {
        "jsonUtf8": "{\"a\":1,}"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "trailing comma in array",
      "input": {
        "jsonUtf8": "[1,]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "unquoted key",
      "input": {
        "jsonUtf8": "{a:1}"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "single quoted string",
      "input": {
        "jsonUtf8": "['a']"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "trailing characters",
      "input": {
        "jsonUtf8": "{} x"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "two documents",
      "input": {
        "jsonUtf8": "{}{}"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "lone high surrogate escape",
      "input": {
        "jsonUtf8": "[\"\\ud800\"]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "lone low surrogate escape",
      "input": {
        "jsonUtf8": "[\"\\udc00\"]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "raw newline in string",
      "input": {
