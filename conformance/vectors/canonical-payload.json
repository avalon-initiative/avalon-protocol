      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "unknown escape",
      "input": {
        "jsonUtf8": "[\"\\x41\"]"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "unterminated string",
      "input": {
        "jsonUtf8": "[\"a"
      },
      "expected": {
        "error": "malformed"
      }
    },
    {
      "name": "comment",
      "input": {
        "jsonUtf8": "[1]//x"
      },
      "expected": {
        "error": "malformed"
      }
    }
  ]
}
