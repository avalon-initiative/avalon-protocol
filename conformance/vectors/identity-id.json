      "kind": "key_acceptability",
      "name": "key: y = 3 (torsion component, accepted)"
    },
    {
      "expected": {
        "acceptable": false
      },
      "input": {
        "publicKeyHex": "f0ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff7f"
      },
      "kind": "key_acceptability",
      "name": "key: non-canonical y = 3 + p"
    },
