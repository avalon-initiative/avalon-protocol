{
  "$schema": "./SCHEMA.md#identity-id",
  "description": "Self-certifying identity id (avalon_protocol::identity_id): identity_id = lowercase_hex(SHA-256(domain tag || ed25519 public key, 32 raw bytes)), the full 256 bits as exactly 64 characters of [0-9a-f] with no prefix. The domain tag is the UTF-8 bytes of 'avalon-identity-id-v1'. Parsing is strict and never normalises: uppercase, any other length (63, 65), 'id:' or 'node:' prefixes and UUID text are rejected. Key acceptability (kind key_acceptability) is the shared Ed25519 policy: canonical encoding and not of small order; a torsion-component key such as y = 3 is accepted. The id differs from the node: shard id for the same key (kind distinct_from_shard_id). Encodings: a public key is lowercase HEX inside signing bytes and standard BASE64 on the wire.",
  "domainTagHex": "6176616c6f6e2d6964656e746974792d69642d7631",
  "domainTagUtf8": "avalon-identity-id-v1",
  "generation": "Deterministic. Seeds are Ed25519 seeds (all bytes equal); publicKeyHex is the derived public key; preimageHex is domainTagHex followed by the key bytes.",
  "supportedIn": [
    "rust",
    "csharp",
    "typescript"
  ],
  "vectors": [
    {
      "expected": {
        "identityId": "7c26a0e34260b2c5bb6a795e29cdfe878c907df4bf8c7425c5a8ce00235558e9",
        "preimageHex": "6176616c6f6e2d6964656e746974792d69642d7631d759793bbc13a2819a827c76adb6fba8a49aee007f49f2d0992d99b825ad2c48"
      },
      "input": {
        "publicKeyHex": "d759793bbc13a2819a827c76adb6fba8a49aee007f49f2d0992d99b825ad2c48",
        "seedHex": "4444444444444444444444444444444444444444444444444444444444444444"
      },
      "kind": "derive",
      "name": "derive: fixed seed 44..44"
    },
    {
      "expected": {
        "identityId": "115f83cfdda474a882627a5e68464846c2ffd2a000164ea0e994f5d893fb957b",
        "preimageHex": "6176616c6f6e2d6964656e746974792d69642d7631c6822637c7d310ec57627be00ba259d253749f4aaf644470cffbe53a35f73242"
      },
      "input": {
        "publicKeyHex": "c6822637c7d310ec57627be00ba259d253749f4aaf644470cffbe53a35f73242",
        "seedHex": "5555555555555555555555555555555555555555555555555555555555555555"
      },
      "kind": "derive",
      "name": "derive: fixed seed 55..55"
    },
    {
      "expected": {
        "valid": true
      },
      "input": {
        "identityId": "7c26a0e34260b2c5bb6a795e29cdfe878c907df4bf8c7425c5a8ce00235558e9"
      },
      "kind": "parse",
      "name": "parse: canonical id"
    },
    {
      "expected": {
        "valid": false
      },
      "input": {
        "identityId": "7C26A0E34260B2C5BB6A795E29CDFE878C907DF4BF8C7425C5A8CE00235558E9"
      },
      "kind": "parse",
      "name": "parse: uppercase hex"
    },
    {
      "expected": {
        "valid": false
      },
      "input": {
        "identityId": "7c26a0e34260b2c5bb6a795e29cdfe878c907df4bf8c7425c5a8ce00235558e"
      },
      "kind": "parse",
      "name": "parse: 63 characters"
    },
    {
      "expected": {
        "valid": false
      },
      "input": {
        "identityId": "7c26a0e34260b2c5bb6a795e29cdfe878c907df4bf8c7425c5a8ce00235558e90"
      },
      "kind": "parse",
      "name": "parse: 65 characters"
    },
    {
      "expected": {
        "valid": false
      },
      "input": {
        "identityId": "id:7c26a0e34260b2c5bb6a795e29cdfe878c907df4bf8c7425c5a8ce00235558e9"
      },
      "kind": "parse",
      "name": "parse: id: prefix"
    },
    {
      "expected": {
        "valid": false
      },
      "input": {
        "identityId": "node:7c26a0e34260b2c5bb6a795e29cdfe878c907df4bf8c7425c5a8ce00235558e9"
      },
      "kind": "parse",
      "name": "parse: node: prefix"
    },
    {
      "expected": {
        "valid": false
      },
      "input": {
        "identityId": "0b7a2c1e-5d4f-4a3b-9c8d-1e2f3a4b5c6d"
      },
      "kind": "parse",
      "name": "parse: UUID text"
    },
    {
      "expected": {
        "valid": false
      },
      "input": {
        "identityId": " c26a0e34260b2c5bb6a795e29cdfe878c907df4bf8c7425c5a8ce00235558e9"
