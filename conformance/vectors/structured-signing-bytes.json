    },
    {
      "name": "string of 65535 bytes",
      "input": {
        "tag": "avalon.conformance.vector",
        "version": 1,
        "fields": [
          {
            "type": "str",
            "repeatUtf8": "a",
            "count": 65535
          }
        ]
