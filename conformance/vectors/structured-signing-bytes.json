  "rejectVectors": [
    {
      "name": "tag of another kind",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e696e7465726573745f636c61696d0001000000010000000261620000",
        "read": [
          "str"
        ]
      },
      "expected": {
        "error": "tag_mismatch"
      }
    },
    {
      "name": "tag is a strict prefix of the message tag",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f0001000000010000",
        "read": []
      },
      "expected": {
        "error": "tag_mismatch"
      }
    },
    {
      "name": "empty message",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "",
        "read": []
