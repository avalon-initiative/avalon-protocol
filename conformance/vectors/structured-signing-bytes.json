  "rejectVectors": [
    {
      "name": "tag of another kind",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e696e7465726573745f636c61696d0001000000026162",
        "read": [
          "str"
        ]
      },
      "expected": {
        "error": "tag_mismatch"
      }
    },
    {
      "name": "tag is a strict prefix of the message tag",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f0001",
        "read": []
      },
      "expected": {
        "error": "tag_mismatch"
      }
    },
    {
      "name": "empty message",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "",
        "read": []
      },
      "expected": {
        "error": "tag_mismatch"
      }
    },
    {
      "name": "message ends inside the version",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f7200",
        "read": []
      },
      "expected": {
        "error": "truncated"
      }
    },
    {
      "name": "message ends inside the length prefix",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f7200010000",
        "read": [
          "str"
        ]
      },
      "expected": {
        "error": "truncated"
      }
    },
    {
      "name": "declared length runs past the end",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f7200010000000261",
        "read": [
          "str"
        ]
      },
      "expected": {
        "error": "truncated"
      }
    },
    {
      "name": "declared length is 4 GiB - 1",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f720001ffffffff78",
        "read": [
          "bytes"
        ]
      },
      "expected": {
        "error": "truncated"
      }
    },
    {
      "name": "fixed field cut short",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f720001000000",
        "read": [
          "u32"
        ]
      },
      "expected": {
        "error": "truncated"
      }
    },
    {
      "name": "bytes remain after the last field",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f720001000000026162",
        "read": []
      },
      "expected": {
        "error": "trailing_bytes"
      }
    },
    {
      "name": "extra byte after a complete field",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f72000100000002616200",
        "read": [
          "str"
        ]
      },
      "expected": {
        "error": "trailing_bytes"
      }
    },
    {
      "name": "string is not UTF-8",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f72000100000002c328",
        "read": [
          "str"
        ]
      },
      "expected": {
        "error": "invalid_utf8"
      }
    },
    {
      "name": "string is a lone surrogate encoding",
      "input": {
        "tag": "avalon.conformance.vector",
        "messageHex": "6176616c6f6e2e636f6e666f726d616e63652e766563746f72000100000003eda080",
        "read": [
          "str"
        ]
      },
      "expected": {
        "error": "invalid_utf8"
      }
    }
  ]
}
