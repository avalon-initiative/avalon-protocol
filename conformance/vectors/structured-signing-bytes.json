    },
    {
      "name": "string of 256 bytes",
      "input": {
        "tag": "avalon.conformance.vector",
        "version": 1,
        "fields": [
          {
            "type": "str",
            "repeatUtf8": "a",
            "count": 256
          }
        ]
      },
      "expected": {
        "signingBytesHex": ""
