<Project Sdk="Microsoft.NET.Sdk">

  <!-- Issue #725: a standalone dev-tool project, deliberately NOT a member of
       AvalonSdk.sln — it only regenerates the checked-in
       AvalonSdk/Generated.cs artifact (mirrors bindings/ts/scripts/generate-types.mjs
       for #726: AvalonSdk consumers, including Unity, import the SDK's .cs
       source directly with no build-time codegen hook, so this tool's own
       target framework/toolchain has no bearing on netstandard2.1 compatibility
       of its *output*.) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Avalon.Sdk.Codegen</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.CodeGeneration.CSharp" Version="14.7.1" />
  </ItemGroup>

</Project>
