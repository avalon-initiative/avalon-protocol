<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- netstandard2.1, not net8+: Unity's Mono/IL2CPP runtimes are the primary
         target for this SDK, and Unity's minimum supported C# API compatibility
         level is netstandard2.1 as of writing. Revisit if/when engine support
         moves on. -->
    <!-- No ImplicitUsings: the generated global-using file requires C# 10+,
         but netstandard2.1's default langversion is 8.0. Explicit usings
         below instead of bumping langversion, to stay conservative for
         whatever C# compiler version a consuming Unity project pins. -->
    <Nullable>enable</Nullable>
    <RootNamespace>Avalon.Sdk</RootNamespace>
    <PackageId>Avalon.Sdk</PackageId>
    <Description>Flagship external SDK for integrating a game with Avalon Protocol. Targets game engines (Unity, and anything else on a netstandard2.1-compatible runtime) as the primary developer-facing surface — see docs/stakeholders/Proposal.md §24.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- netstandard2.1 has no built-in JSON/channel/websocket-client types; these three
         are the smallest dependency set that covers social/guilds/conversations/sync_journal
         without pulling in a full web framework. System.Text.Json (not a hand-rolled DTO
         parser) is netstandard2.0-compatible via this package, so it's the JSON layer here
         too, keeping one serializer for the whole SDK rather than two. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <!-- BouncyCastle.Cryptography: netstandard2.1 has no built-in Ed25519. This is a
         pure-managed implementation (no native binary), which matters for Unity/IL2CPP
         targets that can't easily bundle a per-platform native library the way
         NSec.Cryptography/libsodium would need. Used only by Achievements.cs, for signing
         an integrator's own attestation issuance requests — never for the identity/session
         layer, which is HTTP-token-based, not signature-based, on this SDK's side. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvalonSdk.Tests" />
  </ItemGroup>

</Project>
