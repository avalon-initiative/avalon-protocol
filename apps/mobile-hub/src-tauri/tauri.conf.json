{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avalon",
  "version": "0.1.0",
  "identifier": "protocol.avalon.mobilehub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Avalon",
        "width": 400,
        "height": 700
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8080 ws://127.0.0.1:8080"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["avalon"]
      }
    }
  }
}
