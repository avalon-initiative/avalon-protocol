{
  "name": "@avalon/mobile-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Avalon Hub as a Tauri shell (desktop + mobile) around the same Vue3 UI used by the web hub, so guild chat/presence/friends stay reachable without a game client open. See Proposal.md §22.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "tauri": "tauri",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run"
  },
  "dependencies": {
    "@avalon/api-client": "*",
    "@avalon/ui": "*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "sass": "^1.104.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
