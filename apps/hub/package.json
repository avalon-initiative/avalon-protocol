{
  "name": "@avalon/hub",
  "private": true,
  "version": "0.1.0",
  "description": "Avalon Hub — the web client and first doorway into Avalon Protocol: identity setup, friends, guilds, guild chat, achievements. A client only; it holds no protocol state of its own and talks to avalon-server over HTTP/WebSocket.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-trusted-networks.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run"
  },
  "dependencies": {
    "@avalon/ui": "*",
    "@avalon/api-client": "*",
    "vue": "^3.5.0",
    "vue-router": "^5.3.1",
    "pinia": "^4.0.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.0",
    "sass": "^1.79.0",
    "typescript": "^5.6.0",
    "vue-tsc": "^3.3.11",
    "vite": "^8.3.0",
    "vitest": "^2.1.0",
    "jsdom": "^25.0.0"
  }
}
