# Compose-ready dev defaults — matches docker-compose.yml's `postgres`
# service exactly (user/password/db all `avalon`, published on the default
# port, reachable at `localhost` from the host). `cp .env.compose.example .env`
# after `docker compose up -d` and `make migrate` works with no hand-editing.
#
# These are local-only defaults for a throwaway dev database. See
# `.env.example` for the full, commented list of every variable this repo
# reads (network trust anchors, settlement signing key, recovery delay,
# retention tier, ...) — this file only sets the ones needed to get a fresh
# clone running end to end; everything else there is optional and documented
# there, not repeated here.

DATABASE_URL=postgres://avalon:avalon@localhost:5432/avalon
AVALON_SERVER_ADDR=127.0.0.1:8080

# See .env.example's comment on this one — must stay stable for a given
# database once it's been booted once. `avalon-dev-local` is fine for a
# throwaway local database.
AVALON_NETWORK_ID=avalon-dev-local

# WebAuthn requires `localhost`, not `127.0.0.1` — see .env.example. Must
# match the Hub's actual dev server origin (Vite's default port, 5173).
AVALON_WEBAUTHN_RP_ID=localhost
AVALON_WEBAUTHN_ORIGIN=http://localhost:5173

AVALON_HUB_ORIGIN=http://localhost:5173
